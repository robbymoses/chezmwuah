docs/**

# Hyprland and its Noctalia shell require a Linux machine whose local chezmoi
# profile selects the Hyprland desktop session.
{{ if or (ne .chezmoi.os "linux") (ne .profile.desktop "hyprland") }}
.config/hypr/**
.config/noctalia/**
{{ end }}

# These helpers describe physical ASUS Duo hardware and are only enabled on
# the machine named "asus-duo". Rename this value if the machine's hostname
# changes; check it with `hostname`.
{{ if ne .chezmoi.hostname "asus-duo" }}
.config/zsh/asus-duo.aliases
.config/zsh/asus-duo.functions
.config/zsh/screenpad.aliases
.config/zsh/screenpad.functions
{{ end }}
