{{- $profile := get . "profile" | default (dict) -}}
{{- $role := promptChoiceOnce $profile "role" "Machine role" (list "host" "work" "client") "host" -}}
{{- $agent := promptChoiceOnce $profile "agent" "Preferred coding agent" (list "codex" "antigravity") "codex" -}}
{{- $desktop := promptChoiceOnce $profile "desktop" "Desktop session" (list "hyprland" "macos" "headless") "headless" -}}
# Generated by chezmoi from .chezmoi.toml.tmpl.
# This file is machine-local and is not part of the source state.
mode = "symlink"

[data.profile]
role = {{ $role | quote }}
agent = {{ $agent | quote }}
desktop = {{ $desktop | quote }}
