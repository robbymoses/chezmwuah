# Host-specific functions for ASUS Duo
# Screen management functions

# Toggle ScreenPad Plus status
toggle-screenpad() {
  local monitors
  monitors=$(hyprctl monitors) || return
  if [[ "$monitors" == *"Monitor eDP-2 ("* ]]; then
    echo "Disabling ScreenPad Plus..."
    disable-screenpad
  else
    echo "Enabling ScreenPad Plus..."
    enable-screenpad
  fi
}

# Set ScreenPad Plus position (relative to main screen)
# Usage: set-screenpad-position below|above|left|right
set-screenpad-position() {
  local position
  case "$1" in
    below)
      position=auto-down
      ;;
    above)
      position=auto-up
      ;;
    left)
      position=auto-left
      ;;
    right)
      position=auto-right
      ;;
    *)
      echo "Usage: set-screenpad-position below|above|left|right" >&2
      return 1
      ;;
  esac

  hyprctl eval "hl.monitor({ output = \"eDP-2\", mode = \"preferred\", position = \"$position\", scale = \"auto\", transform = 0, disabled = false })"
}
